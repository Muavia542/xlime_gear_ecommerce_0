# XLIME GEAR API — copy to .env for local development.
NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_URL=mysql://xlime_app:XlimeLocal2026@127.0.0.1:3306/xlime_gear
# Generate a unique 64+ character secret for production. Never commit real secrets.
JWT_SECRET=replace-this-with-at-least-64-random-characters-before-production
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Local is convenient for QA. Use cloudinary in production so uploads are not tied to one app filesystem.
UPLOAD_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Only needed if you intentionally run `npm run db:seed` with NODE_ENV=production.
# Never commit real production credentials.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
