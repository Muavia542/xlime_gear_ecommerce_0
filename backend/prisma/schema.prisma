generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

enum OrderStatus {
  REQUESTED
  CONFIRMED
  IN_PRODUCTION
  READY_TO_SHIP
  SHIPPED
  COMPLETED
  CANCELLED
}

enum RequestStatus {
  NEW
  REVIEWING
  QUOTED
  APPROVED
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  name                String
  phone               String?
  role                Role                 @default(CUSTOMER)
  sessionVersion      Int                  @default(0)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  addresses           Address[]
  cart                Cart?
  orders              Order[]
  customKitRequests   CustomKitRequest[]
  auditLogs           AuditLog[]
  adminMembership     AdminMembership?
  customerNotes       CustomerNote[]
  passwordResetTokens PasswordResetToken[]
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Address {
  id         String   @id @default(cuid())
  label      String   @default("Home")
  fullName   String
  line1      String
  line2      String?
  city       String
  postcode   String
  country    String   @default("United Kingdom")
  phone      String?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?   @db.Text
  imageUrl       String?   @db.Text
  sortOrder      Int       @default(0)
  isActive       Boolean   @default(true)
  subcategories  Json?
  seoTitle       String?
  seoDescription String?   @db.VarChar(320)
  updatedAt      DateTime  @updatedAt
  products       Product[]
}

model Product {
  id                String        @id @default(cuid())
  slug              String        @unique
  sku               String?       @unique
  name              String
  shortDescription  String        @db.VarChar(500)
  description       String        @db.Text
  subcategory       String
  sport             String?
  gender            String        @default("Unisex")
  fabric            String?
  fit               String?
  productType       String        @default("Standard")
  imageUrl          String        @db.Text
  altText           String?
  featured          Boolean       @default(false)
  isCustomizable    Boolean       @default(false)
  teamOrderEligible Boolean       @default(false)
  showPrice         Boolean       @default(false)
  pricePence        Int?
  stockQuantity     Int?          @default(0)
  lowStockThreshold Int           @default(10)
  status            ProductStatus @default(ACTIVE)
  tags              Json?
  seoTitle          String?
  seoDescription    String?       @db.VarChar(320)
  viewCount         Int           @default(0)
  enquiryCount      Int           @default(0)
  cartAddCount      Int           @default(0)
  teamRequestCount  Int           @default(0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  categoryId        String
  category          Category      @relation(fields: [categoryId], references: [id])
  images            ProductImage[]
  cartItems         CartItem[]
  orderItems        OrderItem[]
  collections       CollectionProduct[]
  inventoryTransactions InventoryTransaction[]
  variants          ProductVariant[]
  @@index([categoryId, status])
  @@index([subcategory])
  @@index([sport])
}

model ProductImage {
  id        String  @id @default(cuid())
  url       String  @db.Text
  alt       String
  sortOrder Int     @default(0)
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, sortOrder])
}

model ProductVariant {
  id          String   @id @default(cuid())
  sku         String   @unique
  size        String?
  color       String?
  stock       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId])
}

model Collection {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  imageUrl    String?  @db.Text
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  ruleJson    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  products    CollectionProduct[]
}

model CollectionProduct {
  collectionId String
  productId    String
  sortOrder    Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([collectionId, productId])
  @@index([productId])
}

model InventoryTransaction {
  id             String   @id @default(cuid())
  oldQuantity    Int
  changeQuantity Int
  newQuantity    Int
  reason         String
  note           String?  @db.Text
  performedById  String?
  performedBy    String?
  createdAt      DateTime @default(now())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@index([productId, createdAt])
}

model Cart {
  id         String     @id @default(cuid())
  guestToken String?    @unique
  userId     String?    @unique
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items      CartItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model CartItem {
  id            String   @id @default(cuid())
  quantity      Int      @default(1)
  customisation Json?
  cartId        String
  cart          Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  @@index([cartId])
  @@index([productId])
}

model Order {
  id                 String       @id @default(cuid())
  orderNumber        String       @unique
  status             OrderStatus  @default(REQUESTED)
  customerName       String
  email              String
  phone              String
  deliveryAddress    Json
  notes              String?      @db.Text
  internalValuePence Int?
  assignedAdminId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  userId             String?
  user               User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  @@index([userId])
  @@index([status, createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  productName   String
  productSlug   String
  imageUrl      String   @db.Text
  quantity      Int
  customisation Json?
  createdAt     DateTime @default(now())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  @@index([orderId])
}

model TeamOrderRequest {
  id              String        @id @default(cuid())
  requestNumber   String        @unique
  organisation    String
  contactName     String
  email           String
  phone           String?
  sport           String        @default("Football")
  numberOfPlayers Int?
  requirements    String        @db.Text
  packageInterest String?
  deadline        DateTime?
  status          RequestStatus @default(NEW)
  stage           String        @default("NEW_LEAD")
  assignedAdminId String?
  quoteValuePence Int?
  lastContactAt   DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  notes           TeamOrderNote[]
  @@index([status, createdAt])
  @@index([stage])
}

model TeamOrderNote {
  id          String           @id @default(cuid())
  note        String           @db.Text
  authorId    String?
  authorName  String?
  createdAt   DateTime         @default(now())
  requestId   String
  request     TeamOrderRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId, createdAt])
}

model TeamAccount {
  id                String   @id @default(cuid())
  organisation      String   @unique
  organisationType  String   @default("Club")
  sport             String?
  logoUrl           String?  @db.Text
  primaryContact    String
  email             String
  phone             String?
  secondaryContact  String?
  deliveryAddress   String?  @db.Text
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([email])
}

model CustomKitRequest {
  id             String        @id @default(cuid())
  requestNumber  String        @unique
  teamName       String?
  sport          String        @default("Football")
  primaryColor   String        @default("#C8FF00")
  secondaryColor String        @default("#080A08")
  playerName     String?
  playerNumber   String?
  crestUrl       String?       @db.Text
  notes          String?       @db.Text
  status         RequestStatus @default(NEW)
  stage          String        @default("NEW")
  assignedAdminId String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String?
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  assets         CustomKitAsset[]
  revisions      CustomKitRevision[]
  @@index([status, createdAt])
  @@index([stage])
}

model CustomKitAsset {
  id          String           @id @default(cuid())
  type        String           @default("REFERENCE")
  url         String           @db.Text
  label       String?
  createdAt   DateTime         @default(now())
  requestId   String
  request     CustomKitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@index([requestId])
}

model CustomKitRevision {
  id          String           @id @default(cuid())
  version     Int
  previewUrl  String           @db.Text
  status      String           @default("REVIEW")
  notes       String?          @db.Text
  uploadedBy  String?
  createdAt   DateTime         @default(now())
  requestId   String
  request     CustomKitRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  @@unique([requestId, version])
  @@index([requestId, createdAt])
}

model Quote {
  id                 String      @id @default(cuid())
  quoteNumber        String      @unique
  customerName       String
  email              String
  phone              String?
  sourceType         String      @default("MANUAL")
  sourceId           String?
  status             String      @default("DRAFT")
  subtotalPence      Int         @default(0)
  discountPence      Int         @default(0)
  deliveryPence      Int         @default(0)
  totalPence         Int         @default(0)
  validUntil         DateTime?
  internalNotes      String?     @db.Text
  customerNotes      String?     @db.Text
  createdById        String?
  sentAt             DateTime?
  approvedAt         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              QuoteItem[]
  @@index([status, createdAt])
  @@index([sourceType, sourceId])
}

model QuoteItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  unitPence   Int      @default(0)
  totalPence  Int      @default(0)
  quoteId     String
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  @@index([quoteId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  note       String   @db.Text
  authorId   String?
  authorName String?
  createdAt  DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model Notification {
  id         String   @id @default(cuid())
  type       String
  title      String
  message    String   @db.Text
  entityType String?
  entityId   String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  @@index([isRead, createdAt])
}

model AnnouncementBanner {
  id            String   @id @default(cuid())
  name          String   @unique @default("primary")
  isActive      Boolean  @default(true)
  isDismissible Boolean  @default(true)
  text          String   @default("Built for performance. Custom team orders available.")
  ctaText       String?  @default("Team Orders")
  ctaUrl        String?  @default("/team-orders")
  background    String   @default("#C8FF00")
  textColor     String   @default("#080A08")
  startAt       DateTime?
  endAt         DateTime?
  updatedAt     DateTime @updatedAt
}

model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String   @default("SEASONAL")
  status      String   @default("DRAFT")
  headline    String
  description String?  @db.Text
  destination String?
  startsAt    DateTime?
  endsAt      DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@index([status, startsAt])
}

model MediaAsset {
  id          String   @id @default(cuid())
  fileName    String
  url         String   @db.Text
  mimeType    String
  alt         String
  folder      String   @default("general")
  width       Int?
  height      Int?
  sizeBytes   Int?
  createdAt   DateTime @default(now())
  @@index([folder, createdAt])
}

model AdminRole {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  createdAt   DateTime @default(now())
  memberships AdminMembership[]
  permissions AdminRolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  roles       AdminRolePermission[]
}

model AdminRolePermission {
  roleId       String
  permissionId String
  role         AdminRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@index([permissionId])
}

model AdminMembership {
  id        String    @id @default(cuid())
  userId    String    @unique
  roleId    String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @relation(fields: [roleId], references: [id])
  @@index([roleId])
}

model StoreSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  description String?  @db.Text
  metadata    Json?
  ipAddress   String?
  userAgent   String?  @db.Text
  createdAt   DateTime @default(now())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([entityType, entityId])
}
